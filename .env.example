QUESTIONNAIRE_PATH=app/data/json_IA.json

# URL de la API vista desde el navegador de la demo web. En Docker local suele
# ser el host publicado, no el nombre interno del servicio Docker.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Perfil: demo | prototype_local | production
# prototype_local/production fuerzan LOCAL_ONLY=true internamente.
DEPLOYMENT_PROFILE=demo
DEBUG_TRANSCRIPTS=true
INTERNAL_API_KEY=

# Persistencia (sesiones, sugerencias, revisiones). NO guarda audio ni
# transcripcion completa. Off por defecto.
PERSISTENCE_ENABLED=false
PERSISTENCE_DB_PATH=data/reconocimiento.db

# Proveedor de extraccion: heuristic | ollama | cloudflare | both | both_cloudflare
IA_PROVIDER=both

# En Docker Compose no se levanta Ollama. Si Ollama corre en el host y la API
# corre dentro del contenedor, usa http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ALLOWED_MODELS=qwen3:8b,gpt-oss:20b,gemma4:e4b,gemma4:31b,deepseek-r1:8b,glm-4.7:cloud
# Timeout por llamada (s). Modelos grandes en CPU pueden tardar >180s por lote;
# 300 evita perder lotes por timeout. Bajar si el modelo es rapido.
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
# Hito 2.2: si true, OllamaProvider usa JSON Schema dinamico para restringir
# codigos a los validos por pregunta. Requiere Ollama >= 0.5 y un modelo que
# respete schema (Qwen2.5/Llama3.1+ recomendado). Fallback automatico a json
# si schema falla o questions > OLLAMA_SCHEMA_MAX_QUESTIONS.
OLLAMA_USE_JSON_SCHEMA=false
OLLAMA_SCHEMA_MAX_QUESTIONS=30
# Modo thinking (qwen3, deepseek-r1...). En CPU el razonamiento dispara la
# latencia ~36x (medido 43s vs 1.2s) -> timeouts y lotes perdidos. La extraccion
# estructurada no lo necesita. false = desactivar (recomendado).
OLLAMA_THINK=false

# Hito 6.1: extraccion por lotes pequenos en secciones grandes.
# threshold=0 → siempre extractor monolitico (default).
# threshold=12 → si seccion tiene >= 12 preguntas, dividir en lotes de batch_size.
# Util para reducir contexto LLM y mejorar precision en secciones largas.
IA_BATCH_EXTRACTION_THRESHOLD=0
IA_BATCH_EXTRACTION_SIZE=6
# Lotes en paralelo (module-wide trocea en muchos lotes). Secuencial suma
# latencias y el cliente agota el timeout; las llamadas LLM son I/O-bound, asi
# que paralelizar baja el wall time a oleadas. Subir con cuidado: rate limits
# del proveedor (Cloudflare free tier). 1 = secuencial.
IA_BATCH_MAX_WORKERS=4

# Resumen clinico intermedio. Genera un resumen estructurado del transcript con
# el mismo proveedor LLM, lo expone en la respuesta v1 (clinical_summary) y lo
# pasa como contexto de apoyo a la extraccion. La evidencia sigue anclada al
# transcript original (no al resumen). Solo aplica a providers LLM.
IA_CLINICAL_SUMMARY_ENABLED=false

# --- Guardia anti-alucinacion (calibracion) ---
# Audios con preguntas reformuladas/resumidas producen respuestas validas que NO
# contienen la palabra-tema -> el filtro de relevancia estricto las descartaba.
# fuzzy_grounding: ancla evidencia por cobertura de tokens (>=70%) si no es
#   subcadena literal. Tolera reescritura menor del LLM. Default true.
EXTRACTION_FUZZY_GROUNDING=true
# relevance_scope: transcript (default) valida el tema contra TODO el transcript;
#   evidence (legacy) lo exige dentro de la cita (mas estricto, mas falsos drops).
EXTRACTION_RELEVANCE_SCOPE=transcript
# lenient_mode: omite el check de relevancia (solo exige anclaje al transcript).
#   Escape hatch para audios muy parafraseados. Default false.
EXTRACTION_LENIENT_MODE=false

# --- Audit log (Hito 11) ---
# Path activo del audit log encadenado HMAC. Vacio = audit desactivado.
AUDIT_LOG_PATH=audit.log.jsonl
# Secreto HMAC para la cadena. Obligatorio si AUDIT_LOG_PATH no vacio.
# Rotalo cada 90 dias en production. NUNCA commitearlo.
AUDIT_HMAC_KEY=
# Rotacion automatica por tamano. 0 = sin rotacion. Sugerido 10MB = 10485760.
AUDIT_MAX_SIZE_BYTES=0
# Directorio para archivos rotados. Default: <AUDIT_LOG_PATH parent>/archive
AUDIT_ARCHIVE_DIR=
# Cifrado Fernet de archivos archivados (task #48). El archivo activo sigue
# en plaintext (necesario para append y verify). Tras rotar, el archivado
# se reemplaza por <name>.jsonl.enc cifrado simetricamente.
AUDIT_ENCRYPT_ARCHIVED=false
# Clave Fernet (urlsafe-b64 32 bytes) o passphrase arbitraria (se deriva via
# SHA-256). Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIT_ENCRYPT_KEY=

# --- Audio / transcripcion ---
AUDIO_PROVIDER=faster_whisper
AUDIO_MODEL=medium
# Modelos seleccionables en la UI (deben estar descargados). El modelo actual
# (AUDIO_MODEL) se agrega solo si falta.
AUDIO_ALLOWED_MODELS=large-v3,medium
AUDIO_DEVICE=auto
AUDIO_COMPUTE_TYPE=auto
AUDIO_LANGUAGE=es
AUDIO_BEAM_SIZE=5
AUDIO_VAD_FILTER=true
AUDIO_DIARIZATION=false
AUDIO_CPU_THREADS=0
AUDIO_CACHE_DIR=.cache/audio
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_TTL_HOURS=24
AUDIO_APPLY_FILTERS=true
AUDIO_INITIAL_PROMPT=
AUDIO_FALLBACK_PROVIDER=faster_whisper
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Streaming dedicado (mas pequeno = mas rapido para tiempo real) ---
# Si AUDIO_STREAM_MODEL esta vacio, streaming usa AUDIO_MODEL (lento si es medium/large).
# Recomendado tiny o base para que partials se sientan vivos en CPU.
AUDIO_STREAM_MODEL=small
AUDIO_STREAM_PROVIDER=
AUDIO_STREAM_PARTIAL_EVERY_S=1.0
AUDIO_STREAM_MIN_SEGMENT_S=1.5
AUDIO_STREAM_MAX_SEGMENT_S=12.0
AUDIO_STREAM_SILENCE_MS=600

# --- Providers online opcionales ---
OPENAI_API_KEY=
OPENAI_AUDIO_MODEL=whisper-1
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT_ID=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-medical

# --- LLM online: Cloudflare Workers AI (gratis 10k Neurons/dia) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Modelos CF seleccionables por peticion (override ia_model desde la UI). Solo
# instruct NO-thinking. Excluidos: qwen3, deepseek-r1, glm-flash, qwq, kimi-k2,
# gpt-oss, gemma-3/4, nemotron-3 (emiten razonamiento -> no JSON usable en CF).
CLOUDFLARE_ALLOWED_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/qwen/qwen2.5-coder-32b-instruct,@cf/meta/llama-3.1-8b-instruct-fp8,@cf/ibm/granite-4.0-h-micro,@cf/meta/llama-3.1-8b-instruct-fast,@cf/meta/llama-3.2-3b-instruct,@cf/meta/llama-3.2-1b-instruct,@cf/aisingapore/gemma-sea-lion-v4-27b-it
CLOUDFLARE_TIMEOUT=60
CLOUDFLARE_TEMPERATURE=0.1
CLOUDFLARE_MAX_TOKENS=2048
